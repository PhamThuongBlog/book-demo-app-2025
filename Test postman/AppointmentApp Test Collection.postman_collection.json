			"name": "Set up",
			"item": [
				{
					"name": "Setup - Init Environment",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Tạo user ngẫu nhiên",
									"const id1 = Math.floor(Math.random() * 100000);",
									"const id2 = Math.floor(Math.random() * 100000);",
									"",
									"pm.environment.set(\"user1_username\", \"user\" + id1);",
									"pm.environment.set(\"user1_email\", \"user\" + id1 + \"@example.com\");",
									"pm.environment.set(\"user1_password\", \"password123\");",
									"",
									"pm.environment.set(\"user2_username\", \"user\" + id2);",
									"pm.environment.set(\"user2_email\", \"user\" + id2 + \"@example.com\");",
									"pm.environment.set(\"user2_password\", \"password123\");",
									"",
									"// Tạo thời gian cuộc hẹn",
									"function formatDate(dt) {",
									"  return dt.toISOString().slice(0, 19);",
									"}",
									"",
									"const now = new Date();",
									"const start = new Date(now.getTime() + 10 * 60000);",
									"const end = new Date(start.getTime() + 30 * 60000);",
									"",
									"pm.environment.set(\"appt_start\", formatDate(start));",
									"pm.environment.set(\"appt_end\", formatDate(end));",
									"",
									"// Thông tin cuộc hẹn",
									"pm.environment.set(\"appt_title\", \"Cuộc hẹn tự động \" + Math.floor(Math.random() * 1000));",
									"pm.environment.set(\"appt_description\", \"Mô tả cuộc hẹn demo\");",
									"pm.environment.set(\"appt_location\", \"Phòng họp A\");",
									"",
									"// Thêm địa điểm ngẫu nhiên",
									"pm.environment.set(\"location_name\", \"Phòng họp \" + Math.floor(Math.random() * 100));",
									"",
									"// Reset biến động",
									"pm.environment.unset(\"jwt_token\");",
									"pm.environment.unset(\"appointment_id\");",
									"pm.environment.unset(\"request_id\");"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Setup environment thành công\", function () {",
									"    pm.expect(pm.environment.get(\"user1_username\")).to.be.a(\"string\");",
									"    pm.expect(pm.environment.get(\"appt_start\")).to.match(/\\d{4}-\\d{2}-\\d{2}T/);",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}",
							"host": [
								"{{base_url}}"
							]
						}
					},
					"response": []
				}
			]
		},
